<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/native_ad_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full Background Media (Image/Video) -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:scaleType="centerCrop"
            android:contentDescription="Ad media" />

        <!-- Gradient Overlay (Transparent to Dark - Bottom to Top) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@drawable/native_ad_gradient_overlay" />

        <!-- Two-Column Layout: Left (Text) + Right (CTA Button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Left Side: Title + Description (takes available space) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <!-- Headline - First Line (Title) -->
                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:layout_marginBottom="6dp"/>

                <!-- Body Text - Second & Third Line (Description) -->
                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#E8E8E8"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"/>

            </LinearLayout>

            <!-- Right Side: CTA Button (fixed width, wraps content) -->
            <Button
                android:id="@+id/ad_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minWidth="100dp"
                android:background="@drawable/native_ad_button"/>

        </LinearLayout>

        <!-- Ad Badge (Top-Right Corner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#80000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"/>

    </FrameLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
